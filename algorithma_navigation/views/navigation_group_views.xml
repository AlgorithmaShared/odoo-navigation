<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_navigation_item_list" model="ir.ui.view">
        <field name="name">algorithma.navigation.item.list</field>
        <field name="model">algorithma.navigation.item</field>
        <field name="arch" type="xml">
            <list string="App-Zuordnungen" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="menu_id" domain="[('parent_id', '=', False)]"
                       context="{'ir.ui.menu.full_list': True}"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="group_id" options="{'no_create': True}"/>
                <field name="hidden"/>
            </list>
        </field>
    </record>
    <record id="view_navigation_item_form" model="ir.ui.view">
        <field name="name">algorithma.navigation.item.form</field>
        <field name="model">algorithma.navigation.item</field>
        <field name="arch" type="xml">
            <form string="App-Zuordnung">
                <sheet>
                    <group>
                        <field name="menu_id" domain="[('parent_id', '=', False)]"
                               context="{'ir.ui.menu.full_list': True}"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="group_id" options="{'no_create': True}"/>
                        <field name="sequence"/>
                        <field name="hidden"/>
                    </group>
                    <div class="text-muted">
                        Lassen Sie „Gruppe“ leer, um die App direkt in der Seitenleiste
                        anzuzeigen. Nicht zugeordnete Apps und Apps archivierter Gruppen
                        werden ebenfalls direkt angezeigt. Ausgeblendete Apps bleiben
                        für alle Benutzer in der Seitenleiste verborgen, auch ohne Gruppe
                        oder bei ausgeschalteter Gruppierung.
                        Nach dem Speichern die Seite neu laden.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_navigation_item_search" model="ir.ui.view">
        <field name="name">algorithma.navigation.item.search</field>
        <field name="model">algorithma.navigation.item</field>
        <field name="arch" type="xml">
            <search string="App-Zuordnungen">
                <field name="menu_id"/>
                <field name="group_id"/>
                <filter name="ungrouped" string="Ohne Gruppe" domain="[('group_id', '=', False)]"/>
                <filter name="hidden" string="Ausgeblendet" domain="[('hidden', '=', True)]"/>
                <group>
                    <filter name="group_by_group" string="Gruppe" context="{'group_by': 'group_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_navigation_items" model="ir.actions.act_window">
        <field name="name">App-Zuordnungen</field>
        <field name="res_model">algorithma.navigation.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_navigation_item_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Eine App-Zuordnung anlegen</p>
            <p>Wählen Sie eine App und optional eine Gruppe. Ohne Gruppe erscheint die App direkt in der Seitenleiste.</p>
        </field>
    </record>
    <record id="view_navigation_group_list" model="ir.ui.view">
        <field name="name">algorithma.navigation.group.list</field>
        <field name="model">algorithma.navigation.group</field>
        <field name="arch" type="xml">
            <list string="App-Gruppen">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon" widget="algorithma_group_icon"/>
                <field name="color" widget="algorithma_group_color"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_navigation_group_form" model="ir.ui.view">
        <field name="name">algorithma.navigation.group.form</field>
        <field name="model">algorithma.navigation.group</field>
        <field name="arch" type="xml">
            <form string="App-Gruppe">
                <sheet>
                    <widget name="web_ribbon" title="Archiviert" bg_color="text-bg-warning" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="icon" widget="algorithma_group_icon"/>
                        <field name="color" widget="algorithma_group_color"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="menu_id" domain="[('parent_id', '=', False)]"
                                   context="{'ir.ui.menu.full_list': True}"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="hidden"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        Jede App kann einer Gruppe zugeordnet werden. Nicht zugeordnete Apps
                        und Apps archivierter Gruppen erscheinen direkt in der Seitenleiste,
                        sofern sie nicht ausgeblendet sind.
                        Benutzer sehen weiterhin nur Apps, für die sie berechtigt sind.
                        „In Seitenleiste ausblenden“ gilt für alle Benutzer und entzieht
                        keine App-Berechtigungen. Die Auswahl bleibt beim Archivieren
                        oder Löschen der Gruppe erhalten. Unter „App-Zuordnungen“ können
                        Sie eine App auch ohne Gruppe verwalten oder ausblenden.
                        Nach dem Speichern die Seite neu laden, um die Navigation zu aktualisieren.
                    </div>
                    <button name="%(action_navigation_items)d" type="action"
                            string="App-Zuordnungen verwalten" class="btn-link" icon="oi-arrow-right"
                            groups="base.group_system"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_navigation_group_search" model="ir.ui.view">
        <field name="name">algorithma.navigation.group.search</field>
        <field name="model">algorithma.navigation.group</field>
        <field name="arch" type="xml">
            <search string="App-Gruppen">
                <field name="name"/>
                <filter name="archived" string="Archiviert" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_navigation_groups" model="ir.actions.act_window">
        <field name="name">App-Gruppen</field>
        <field name="res_model">algorithma.navigation.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_navigation_group_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Eine App-Gruppe anlegen</p>
            <p>Ordnen Sie die vorhandenen Apps in frei benannte Gruppen ein.</p>
        </field>
    </record>
    <menuitem id="menu_navigation" name="Navigation" parent="base.menu_administration"
              groups="base.group_system" sequence="45"/>
    <menuitem id="menu_navigation_groups" name="App-Gruppen" parent="menu_navigation"
              action="action_navigation_groups" groups="base.group_system" sequence="10"/>
    <menuitem id="menu_navigation_items" name="App-Zuordnungen" parent="menu_navigation"
              action="action_navigation_items" groups="base.group_system" sequence="20"/>
    <record id="res_config_settings_view_form_navigation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.algorithma.navigation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Navigation" name="algorithma_navigation" groups="base.group_system">
                    <setting id="algorithma_navigation_grouping" string="Apps gruppieren"
                             help="Gilt für alle Benutzer. Ohne Gruppierung erscheinen die Apps direkt. Gruppen und ausgeblendete Apps bleiben gespeichert.">
                        <field name="algorithma_navigation_grouping_enabled"/>
                        <div class="content-group mt8">
                            <button name="%(action_navigation_groups)d" type="action"
                                    string="App-Gruppen verwalten" class="btn-link" icon="oi-arrow-right"/>
                            <br/>
                            <button name="%(action_navigation_items)d" type="action"
                                    string="App-Zuordnungen verwalten" class="btn-link" icon="oi-arrow-right"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
