<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_navigation_item_list" model="ir.ui.view">
        <field name="name">algorithma.navigation.item.list</field>
        <field name="model">algorithma.navigation.item</field>
        <field name="arch" type="xml">
            <list string="App Assignments" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="menu_id" domain="[('parent_id', '=', False)]"
                       context="{'ir.ui.menu.full_list': True}"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="group_id" options="{'no_create': True}"/>
                <field name="hidden"/>
            </list>
        </field>
    </record>
    <record id="view_navigation_item_form" model="ir.ui.view">
        <field name="name">algorithma.navigation.item.form</field>
        <field name="model">algorithma.navigation.item</field>
        <field name="arch" type="xml">
            <form string="App Assignment">
                <sheet>
                    <group>
                        <field name="menu_id" domain="[('parent_id', '=', False)]"
                               context="{'ir.ui.menu.full_list': True}"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="group_id" options="{'no_create': True}"/>
                        <field name="sequence"/>
                        <field name="hidden"/>
                    </group>
                    <div class="text-muted">
                        Leave “Group” empty to show the app directly in the sidebar.
                        Unassigned apps and apps of archived groups are shown directly
                        as well. Hidden apps stay hidden from the sidebar for all users,
                        also without a group or with grouping switched off.
                        Reload the page after saving.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_navigation_item_search" model="ir.ui.view">
        <field name="name">algorithma.navigation.item.search</field>
        <field name="model">algorithma.navigation.item</field>
        <field name="arch" type="xml">
            <search string="App Assignments">
                <field name="menu_id"/>
                <field name="group_id"/>
                <filter name="ungrouped" string="Without group" domain="[('group_id', '=', False)]"/>
                <filter name="hidden" string="Hidden" domain="[('hidden', '=', True)]"/>
                <group>
                    <filter name="group_by_group" string="Group" context="{'group_by': 'group_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_navigation_items" model="ir.actions.act_window">
        <field name="name">App Assignments</field>
        <field name="res_model">algorithma.navigation.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_navigation_item_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an app assignment</p>
            <p>Choose an app and optionally a group. Without a group the app appears directly in the sidebar.</p>
        </field>
    </record>
    <record id="view_navigation_group_list" model="ir.ui.view">
        <field name="name">algorithma.navigation.group.list</field>
        <field name="model">algorithma.navigation.group</field>
        <field name="arch" type="xml">
            <list string="App Groups">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon" widget="algorithma_group_icon"/>
                <field name="color" widget="algorithma_group_color"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_navigation_group_form" model="ir.ui.view">
        <field name="name">algorithma.navigation.group.form</field>
        <field name="model">algorithma.navigation.group</field>
        <field name="arch" type="xml">
            <form string="App Group">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-warning" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="icon" widget="algorithma_group_icon"/>
                        <field name="color" widget="algorithma_group_color"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="menu_id" domain="[('parent_id', '=', False)]"
                                   context="{'ir.ui.menu.full_list': True}"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="hidden"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        Every app can be assigned to one group. Unassigned apps and apps
                        of archived groups appear directly in the sidebar unless they are
                        hidden. Users still only see apps they are permitted to use.
                        “Hide in sidebar” applies to all users and takes away no app
                        permissions. The choice stays when the group is archived or
                        deleted. Under “App Assignments” you can also manage or hide an
                        app without a group.
                        Reload the page after saving to refresh the navigation.
                    </div>
                    <button name="%(action_navigation_items)d" type="action"
                            string="Manage app assignments" class="btn-link" icon="oi-arrow-right"
                            groups="base.group_system"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_navigation_group_search" model="ir.ui.view">
        <field name="name">algorithma.navigation.group.search</field>
        <field name="model">algorithma.navigation.group</field>
        <field name="arch" type="xml">
            <search string="App Groups">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_navigation_groups" model="ir.actions.act_window">
        <field name="name">App Groups</field>
        <field name="res_model">algorithma.navigation.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_navigation_group_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an app group</p>
            <p>Sort the existing apps into groups that you name freely.</p>
        </field>
    </record>
    <menuitem id="menu_navigation" name="Navigation" parent="base.menu_administration"
              groups="base.group_system" sequence="45"/>
    <menuitem id="menu_navigation_groups" name="App Groups" parent="menu_navigation"
              action="action_navigation_groups" groups="base.group_system" sequence="10"/>
    <menuitem id="menu_navigation_items" name="App Assignments" parent="menu_navigation"
              action="action_navigation_items" groups="base.group_system" sequence="20"/>
    <record id="res_config_settings_view_form_navigation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.algorithma.navigation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Navigation" name="algorithma_navigation" groups="base.group_system">
                    <setting id="algorithma_navigation_grouping" string="Group apps"
                             help="Applies to all users. Without grouping the apps appear directly. Groups and hidden apps stay stored.">
                        <field name="algorithma_navigation_grouping_enabled"/>
                        <div class="content-group mt8">
                            <button name="%(action_navigation_groups)d" type="action"
                                    string="Manage app groups" class="btn-link" icon="oi-arrow-right"/>
                            <br/>
                            <button name="%(action_navigation_items)d" type="action"
                                    string="Manage app assignments" class="btn-link" icon="oi-arrow-right"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
