<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Edit mode of the sidebar: groups and apps are arranged by drag and drop.
         Rows are plain list items, not links, so a click never leaves the page.
         OWL 3: component members need `this.`, t-call passes variables as attributes. -->
    <t t-name="algorithma_navigation.NavigationEditor">
        <div class="algorithma_nav_editor" t-ref="this.rootRef">
            <p class="algorithma_nav_editor_hint">
                Apps und Gruppen mit der Maus verschieben. Die Anordnung gilt für alle Benutzer.
            </p>

            <div class="algorithma_nav_edit_groups">
                <section t-foreach="this.state.sections" t-as="section" t-key="section.key"
                         class="algorithma_nav_edit_group"
                         t-att-data-group-id="section.id" t-att-style="section.style">
                    <div class="algorithma_nav_edit_header">
                        <span class="algorithma_nav_edit_grip" title="Gruppe verschieben" aria-hidden="true">
                            <t t-call="algorithma_navigation.EditorIconGrip"/>
                        </span>
                        <input t-if="this.state.renamingGroupId === section.id"
                               type="text" class="algorithma_nav_edit_name_input"
                               aria-label="Name der Gruppe" maxlength="60"
                               t-att-value="this.state.renameValue"
                               t-on-input="this.onRenameInput"
                               t-on-keydown="this.onRenameKeydown" t-on-blur="this.commitRename"/>
                        <t t-else="">
                            <t t-if="section.icon" t-call="algorithma_navigation.GroupIcon"
                               groupIcon="section.icon"/>
                            <span class="algorithma_nav_edit_name" t-att-title="section.name"
                                  t-on-dblclick="() => this.startRename(section.id)" t-out="section.name"/>
                        </t>
                        <span class="algorithma_nav_edit_actions">
                        <button type="button" class="algorithma_nav_edit_action"
                                title="Gruppe umbenennen" aria-label="Gruppe umbenennen"
                                t-on-click="() => this.startRename(section.id)">
                            <t t-call="algorithma_navigation.EditorIconPencil"/>
                        </button>
                        <button type="button" class="algorithma_nav_edit_action"
                                title="Farbe und Symbol" aria-label="Farbe und Symbol"
                                t-on-click="() => this.openGroupStyle(section)">
                            <t t-call="algorithma_navigation.EditorIconColour"/>
                        </button>
                        <button type="button" class="algorithma_nav_edit_action"
                                title="Gruppe löschen" aria-label="Gruppe löschen"
                                t-on-click="() => this.deleteGroup(section)">
                            <t t-call="algorithma_navigation.EditorIconTrash"/>
                        </button>
                        </span>
                    </div>
                    <ul class="algorithma_nav_dropzone" t-att-data-group-id="section.id"
                        t-att-aria-label="section.name">
                        <li t-foreach="section.apps" t-as="app" t-key="app.id"
                            class="algorithma_nav_edit_app" t-att-data-menu-id="app.id">
                            <t t-call="algorithma_navigation.NavigationEditorApp" app="app"/>
                        </li>
                        <li t-if="!section.apps.length" class="algorithma_nav_drop_hint">
                            Apps hierher ziehen
                        </li>
                    </ul>
                </section>
            </div>

            <button type="button" class="algorithma_nav_add_group" t-on-click="this.addGroup">
                <t t-call="algorithma_navigation.EditorIconPlus"/>
                <span>Neue Gruppe</span>
            </button>

            <div class="algorithma_nav_edit_ungrouped">
                <div class="algorithma_nav_edit_ungrouped_title">Ohne Gruppe</div>
                <ul class="algorithma_nav_dropzone" aria-label="Ohne Gruppe">
                    <li t-foreach="this.state.ungrouped" t-as="app" t-key="app.id"
                        class="algorithma_nav_edit_app" t-att-data-menu-id="app.id">
                        <t t-call="algorithma_navigation.NavigationEditorApp" app="app"/>
                    </li>
                    <li t-if="!this.state.ungrouped.length" class="algorithma_nav_drop_hint">
                        Apps hierher ziehen, um sie aus der Gruppe zu lösen
                    </li>
                </ul>
            </div>

            <button type="button" class="algorithma_nav_editor_done" t-on-click="this.props.onClose">
                <t t-call="algorithma_navigation.EditorIconCheck"/>
                <span>Fertig</span>
            </button>
        </div>
    </t>

    <!-- Odoo 20 ships no Font Awesome any more: the editor draws its own symbols.
         They are 1em wide, so they follow the font size like an icon font. -->

    <t t-name="algorithma_navigation.EditorIconPencil">
        <svg class="algorithma_nav_editor_icon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 20h4L19 9l-4-4L4 16v4ZM13.5 6.5l4 4"/>
        </svg>
    </t>

    <t t-name="algorithma_navigation.EditorIconCheck">
        <svg class="algorithma_nav_editor_icon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M5 12.5l4.5 4.5L19 7.5"/>
        </svg>
    </t>

    <t t-name="algorithma_navigation.EditorIconPlus">
        <svg class="algorithma_nav_editor_icon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 5v14M5 12h14"/>
        </svg>
    </t>

    <t t-name="algorithma_navigation.EditorIconTrash">
        <svg class="algorithma_nav_editor_icon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 7h16M9 7V4h6v3M6.5 7l1 13h9l1-13M10 11v6M14 11v6"/>
        </svg>
    </t>

    <t t-name="algorithma_navigation.EditorIconColour">
        <svg class="algorithma_nav_editor_icon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 3.5s6 6.3 6 10.5a6 6 0 0 1-12 0c0-4.2 6-10.5 6-10.5Z"/>
        </svg>
    </t>

    <!-- Six dots: the grip a group is dragged by. -->
    <t t-name="algorithma_navigation.EditorIconGrip">
        <svg class="algorithma_nav_editor_icon" xmlns="http://www.w3.org/2000/svg" width="1.15em" height="1.15em"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
             stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M9 5.5v.01M15 5.5v.01M9 12v.01M15 12v.01M9 18.5v.01M15 18.5v.01"/>
        </svg>
    </t>

    <!-- One draggable app row: the native app icon and name, as in the MuK sidebar. -->
    <t t-name="algorithma_navigation.NavigationEditorApp">
        <img class="mk_apps_sidebar_icon" alt="" draggable="false"
             t-att-src="app.webIconData || '/base/static/description/icon.png'"/>
        <span class="algorithma_nav_edit_app_name" t-out="app.label"/>
    </t>

    <!-- The editor takes the place of the normal list while it is open. -->
    <t t-name="algorithma_navigation.NavigationEditorHost"
       t-inherit="muk_web_appsbar.AppsBar" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('mk_apps_sidebar_menu')]/t[@t-foreach]" position="before">
            <li t-if="this.algorithmaNavigationEditor.active" class="algorithma_nav_editor_host">
                <NavigationEditor apps="this.algorithmaNavigationApps"
                                  onConfigChanged.bind="this.algorithmaApplyNavigationConfig"
                                  onClose.bind="this.algorithmaToggleNavigationEditor"/>
            </li>
        </xpath>
    </t>
</templates>
