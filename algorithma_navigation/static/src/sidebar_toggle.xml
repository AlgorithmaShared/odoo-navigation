<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="algorithma_navigation.SidebarToggle"
       t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="before">
            <button type="button" class="algorithma_sidebar_toggle"
                    t-att-title="this.algorithmaSidebarToggleLabel"
                    t-att-aria-label="this.algorithmaSidebarToggleLabel"
                    t-att-aria-expanded="this.algorithmaSidebarState.collapsed ? 'false' : 'true'"
                    aria-controls="algorithma-apps-sidebar"
                    t-on-click="this.algorithmaToggleSidebar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2"/>
                    <path d="M9 4v16"/>
                    <path t-att-d="this.algorithmaSidebarState.collapsed ? 'm13 9 3 3-3 3' : 'm16 9-3 3 3 3'"/>
                </svg>
            </button>
        </xpath>
    </t>
    <t t-name="algorithma_navigation.SidebarToggleTarget"
       t-inherit="muk_web_appsbar.AppsBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('mk_apps_sidebar_panel')]" position="attributes">
            <attribute name="id">algorithma-apps-sidebar</attribute>
        </xpath>
        <xpath expr="//div[hasclass('mk_apps_sidebar')]/ul[hasclass('mk_apps_sidebar_menu')]/*[1]" position="before">
            <li class="algorithma_sidebar_control">
                <button type="button" class="algorithma_sidebar_control_button"
                        t-att-title="this.algorithmaSidebarControlLabel"
                        t-att-aria-label="this.algorithmaSidebarControlLabel"
                        t-att-aria-expanded="this.algorithmaSidebarControlState.collapsed ? 'false' : 'true'"
                        aria-controls="algorithma-apps-sidebar"
                        t-on-click="this.algorithmaRequestSidebarToggle">
                    <span class="algorithma_sidebar_control_label">Navigation</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path t-att-d="this.algorithmaSidebarControlState.collapsed ? 'm9 6 6 6-6 6' : 'm15 6-6 6 6 6'"/>
                    </svg>
                </button>
                <!-- Every user: switch the own sidebar into the drag and drop edit mode. -->
                <button t-if="this.algorithmaCanEditNavigation" type="button"
                        class="algorithma_nav_edit_toggle"
                        t-att-class="{'active': this.algorithmaNavigationEditor.active}"
                        t-att-title="this.algorithmaNavigationEditorLabel"
                        t-att-aria-label="this.algorithmaNavigationEditorLabel"
                        t-att-aria-pressed="this.algorithmaNavigationEditor.active ? 'true' : 'false'"
                        t-on-click="this.algorithmaToggleNavigationEditor">
                    <t t-if="this.algorithmaNavigationEditor.active" t-call="algorithma_navigation.EditorIconCheck"/>
                    <t t-else="" t-call="algorithma_navigation.EditorIconPencil"/>
                </button>
            </li>
        </xpath>
        <xpath expr="//a[@t-att-data-menu-id]" position="attributes">
            <attribute name="t-att-title">app.label</attribute>
        </xpath>
    </t>
    <t t-name="algorithma_navigation.SidebarGroupedLinkTitle"
       t-inherit="algorithma_navigation.AppLink" t-inherit-mode="extension">
        <xpath expr="//a[@t-att-data-menu-id]" position="attributes">
            <attribute name="t-att-title">app.label</attribute>
        </xpath>
    </t>
</templates>
